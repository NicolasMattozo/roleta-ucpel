# ==============================================================================
# Roleta Biomedicina UCPel Pelotas - Variáveis de Ambiente
# Copie este arquivo para `.env.local` em desenvolvimento
# e configure as mesmas variáveis na Vercel (Settings > Environment Variables).
# ==============================================================================

# URL do projeto no Supabase (Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública anon do Supabase (Settings > API > Project API keys > anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave secreta service_role do Supabase (Settings > API > service_role)
# IMPORTANTE: nunca exponha esta chave no frontend (sem prefixo NEXT_PUBLIC_).
SUPABASE_SERVICE_ROLE_KEY=

# Senha do painel administrativo (/admin) para gerenciar prêmios e exportar ganhadores
ADMIN_PASSWORD=
